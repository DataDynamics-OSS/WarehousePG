# =============================================================================
# WarehousePG build configuration
# Read by both the Makefile (make include) and the shell scripts (source).
# Keep every line as KEY=value (no spaces around =) so it stays valid for both.
# =============================================================================

# ---- Source (WarehousePG server code) ---------------------------------------
WHPG_TAG=7.5.0-WHPG
WHPG_REPO_URL=https://github.com/warehouse-pg/warehouse-pg.git
# Optional: build from a local clone instead of the network. When set, the
# source is exported with `git archive <tag>` from this path (fast, offline).
# Example: WHPG_LOCAL_REPO=/root/projects/warehouse-pg
WHPG_LOCAL_REPO=

# ---- Version strings --------------------------------------------------------
# GP_VERSION  : full WHPG version, baked into the binary (postgres --gp-version),
#               the install directory name, and greenplum_path.sh.
# RPM_VERSION : RPM `Version:` field. RPM forbids '-', so use the numeric part.
# RPM_RELEASE : RPM `Release:` field ( `.el9` is appended automatically ).
GP_VERSION=7.5.0-WHPG
RPM_VERSION=7.5.0
RPM_RELEASE=1

# ---- Install layout ---------------------------------------------------------
# Final GPHOME = ${GPHOME_BASE}/${GP_NAME}-${GP_VERSION}
#   -> /usr/local/greenplum-db-7.5.0-WHPG
# A version-less symlink is maintained by the RPM:
#   /usr/local/greenplum-db -> /usr/local/greenplum-db-7.5.0-WHPG
# NOTE: this replaces the old dev convention /usr/local/greenplum-db-devel.
GPHOME_BASE=/usr/local
GP_NAME=greenplum-db

# ---- Target platform / toolchain image --------------------------------------
EL_VERSION=9
ARCH=x86_64
IMAGE=ghcr.io/warehouse-pg/whpg-rocky9-build:latest
