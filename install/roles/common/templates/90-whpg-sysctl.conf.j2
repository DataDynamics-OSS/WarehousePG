# WarehousePG 권장 커널 파라미터 (Ansible 관리 — 직접 수정 금지)
# shmall/shmmax 는 호스트 메모리에서 계산합니다(전체 RAM의 약 절반).
{% set page_size = 4096 %}
{% set ram_bytes = ansible_facts.memtotal_mb | int * 1024 * 1024 %}
{% set shmall = (ram_bytes // page_size // 2) %}
{% set shmmax = shmall * page_size %}
kernel.shmall = {{ shmall }}
kernel.shmmax = {{ shmmax }}
kernel.shmmni = 4096
kernel.sem = 250 2048000 200 8192
kernel.msgmni = 2048
kernel.msgmax = 65536
kernel.msgmnb = 65536
vm.overcommit_memory = 2
vm.overcommit_ratio = {{ vm_overcommit_ratio }}
vm.swappiness = 10
vm.dirty_background_ratio = 3
vm.dirty_ratio = 10
net.ipv4.ip_local_port_range = 10000 65535
net.core.rmem_max = 4194304
net.core.wmem_max = 4194304
net.core.netdev_max_backlog = 10000
net.ipv4.tcp_max_syn_backlog = 4096
net.ipv4.conf.all.arp_filter = 1
